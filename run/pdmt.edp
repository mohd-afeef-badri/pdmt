/*****************************************************************************

         This file is a part of PDMT (Parallel Dual Meshing Tool)

     -------------------------------------------------------------------

     Author(s): Mohd Afeef Badri
     Email    : mohd-afeef.badri@cea.com
     Date     : 14/01/2022
     Comment  : The program finds dual of a triangular mesh and then
                create a polyhedral mesh from the underlying Voronoi
                frame.

     -------------------------------------------------------------------

     PDMT a parallel  dual meshing tool uses   finite  element framework
     to convert a triangular / tetrahedral mesh into a  polyhedral  mesh.
     PDMT is distributed  in  the  hope that it  will be useful, HOWEVER
     WITHOUT ANY WARRANTY; or without  even  implied warranty of FITNESS
     FOR A PARTICULAR PURPOSE.

     -------------------------------------------------------------------

     USAGE:
     how to run

       PDMT --debug --mesh ./name/of/mesh/mesh.msh
       PDMT --mesh ./name/of/mesh/mesh.mesh

     command line parameters

       --version  : to print version info
       --help     : to print some help info
       --debug    : to print some verbos info
       --mesh     : to provide external mesh (accepts .mesh, .msh, .vtk, .med)
       --out_mesh : to provide saved mesh name (accepts , .med, .vtu, .vtk, typ2)
                    also accepts ("square" or "circle")
       --med_mesh_name     : to provide name of mesh in med file

*******************************************************************************/


load    "./../src/pdmt";                 // Load pdmt library
//load    "PETSc";

include "getARGV.idp";                   // Activate Commandline arguments
include "meshIO.idp";                    // mesh loading and saving

//----------------------------------------------------------------------
//       Nomenclature
//----------------------------------------------------------------------
/*

  Th    =  $\mathcal T_h$     = 2D triangular mesh
  Ph    =  $\mathcal P_h$     = 2D polygon mesh
  Ti    =     $\T_i$          = triangular element of mesh Th
  Pi    =     $\P_i$          = polygon element of mesh Th
  Name  =       -             = name of something
  Nn    =     $N_n$           = number of nodes
  Nni   =     $N_ni$          = number of nodes inside (!boundary)
  Nnb   =     $N_nb$          = number of nodes on boundary
  Nt    =     $N_t$           = number of triangles
  Nbe   =     $N_be$          = number of boundary edges
  Np    =     $N_p$           = number of polygons
  Ne    =     $N_e$           = number of edges
  V0h   =     $V0_{h}$        = piecewise constant finite element space
  V1h   =     $V1_{h}$        = piecewise linear finite element space
  ThVix = ${\V_x\}_{i=0}^N_n$ = x - coordinate at each vertex of mesh
  ThViy = ${\V_y\}_{i=0}^N_n$ = y - coordinate at each vertex of mesh
  ThTix = ${\T_x\}_{i=0}^N_t$ = triangle center node x - coordinate
  ThTiy = ${\T_y\}_{i=0}^N_t$ = triangle center node y - coordinate
  ThEix = ${\E_x\}_{i=0}^N_be$= edge center node x - coordinate
  ThEiy = ${\E_y\}_{i=0}^N_be$= edge center node y - coordinate
  PhV   = $\{Vx, Vy\}_{i=1}^{N_n}$ = 2D polygon mesh vertices vector
*/

//    macro dimension()2// EOM
//    include "macro_ddm.idp"

func int run3D (){

  if (usedARGV("--version") != -1) {
    PdmtVersion();
    return 0;
  }

  if (usedARGV("--help") != -1) {
    PdmtHelp();
    return 0;
  }

  string ThName      = getARGV("--mesh", "");
  string ThNameOut   = getARGV("--out_mesh", "PDMT_POLY_MESH_");
  string MedMeshName = getARGV("--med_mesh_name", "Mesh_1");
  real featureAngle  = getARGV("--feature_angle", 45.0);
  string conserveEdge = getARGV("--conserve_edge", "");
  string dualMode     = getARGV("--mode", "smooth_dual");
  int smoothIterations = getARGV("--smooth_iterations", 0);
  real smoothRelaxation = getARGV("--smooth_relaxation", 0.3);

  mesh3 Th3 = loadTheMesh3(ThName, MedMeshName);

  real[int,int] PhV(0,0);
  int[int][int] PhF;
  int[int][int] PhC;
  int[int] PhLabels;
  int[int] PhFaceLabels;

  int numberOfPolyhedra = PdmtBuildDual3D(Th3,
      nodes = PhV,
      faces = PhF,
      cells = PhC,
      labels = PhLabels,
      faceLabels = PhFaceLabels,
      featureAngle = featureAngle,
      meshFile = ThName,
      conserveEdge = conserveEdge,
      mode = dualMode,
      medMeshName = MedMeshName,
      smoothIterations = smoothIterations,
      smoothRelaxation = smoothRelaxation);

  if (numberOfPolyhedra <= 0) {
    cout << "PDMT failed to build a 3D dual mesh" << endl;
    exit(1111);
  }

  if (ThNameOut == "PDMT_POLY_MESH_")
    ThNameOut = ThName + "_poly3d.vtu";

  if (ThNameOut.find(".vtk") == -1 && ThNameOut.find(".vtu") == -1 &&
      ThNameOut.find(".med") == -1) {
    cout << " ******************* ERROR ***********************\n"
         << "  3D polyhedra can be written as .vtk, .vtu, or .med\n"
         << " ******************* ERROR ***********************\n" << endl;
    exit(1111);
  }

  PdmtPolyMeshWrite(ThNameOut,
      nodes = PhV,
      cells = PhC,
      faces = PhF,
      labels = PhLabels,
      faceLabels = PhFaceLabels);

  return 0;
}

func int run3S (){

  if (usedARGV("--version") != -1) {
    PdmtVersion();
    return 0;
  }

  if (usedARGV("--help") != -1) {
    PdmtHelp();
    return 0;
  }

  string ThName       = getARGV("--mesh", "");
  string ThNameOut    = getARGV("--out_mesh", "PDMT_POLY_MESH_");
  string MedMeshName  = getARGV("--med_mesh_name", "Mesh_1");
  real featureAngle   = getARGV("--feature_angle", 45.0);
  string conserveEdge = getARGV("--conserve_edge", "");
  string dualMode     = getARGV("--mode", "subdivided_dual");

  meshS ThS = loadTheMeshS(ThName, MedMeshName);

  real[int,int] PhV(0,0);
  int[int][int] PhC;
  int[int] PhLabels;

  int numberOfPolygons = PdmtBuildDual3S(ThS,
      nodes = PhV,
      cells = PhC,
      labels = PhLabels,
      featureAngle = featureAngle,
      meshFile = ThName,
      conserveEdge = conserveEdge,
      mode = dualMode,
      medMeshName = MedMeshName);

  if (numberOfPolygons <= 0) {
    cout << "PDMT failed to build a 3S dual mesh" << endl;
    exit(1111);
  }

  if (ThNameOut == "PDMT_POLY_MESH_")
    ThNameOut = ThName + "_poly3s.vtu";

  if (ThNameOut.find(".vtk") == -1 && ThNameOut.find(".vtu") == -1 &&
      ThNameOut.find(".med") == -1) {
    cout << " ******************* ERROR ***********************\n"
         << "  3S polygons can be written as .vtk, .vtu, or .med\n"
         << " ******************* ERROR ***********************\n" << endl;
    exit(1111);
  }

  PdmtPolyMeshWrite(ThNameOut,
      nodes = PhV,
      cells = PhC,
      labels = PhLabels);

  return 0;
}

func int run2D (){

  if (usedARGV("--version") != -1) {
    PdmtVersion();
    return 0;
  }

  if (usedARGV("--help") != -1) {
    PdmtHelp();
    return 0;
  }

//-----------------------------------------------------------------------
// load mesh
//-----------------------------------------------------------------------
 string ThName      = getARGV( "--mesh" , "circle" );              // Name of the mesh
 string ThNameOut   = getARGV( "--out_mesh" , "PDMT_POLY_MESH_" ); // Name of the saved mesh
 string MedMeshName = getARGV( "--med_mesh_name" , "Mesh_1" );     // Name of the mesh
 string dualMode    = getARGV( "--mode" , "smooth_dual" );         // smooth_dual or subdivided_dual
 if (dualMode != "smooth_dual" && dualMode != "subdivided_dual") {
   cout << "PDMT 2D --mode must be smooth_dual or subdivided_dual" << endl;
   exit(1111);
 }
 int smoothDual2D = (dualMode == "smooth_dual");
 mesh   Th          = loadTheMesh( ThName , MedMeshName );         // function in meshIO.edp



//-----------------------------------------------------------------------
// build distributed mesh (ParMetis is used)
//-----------------------------------------------------------------------
// buildDmesh(Th);                           // partition the mesh



//-----------------------------------------------------------------------
// get mesh info
//-----------------------------------------------------------------------
 int[int] isBorderNode ,                    // vector to mark boundary node
          meshInfo     ;                    // info on mesh (Nn, Nt, Nbe,..)

 PdmtGetMeshInfo(Th,isBorderNode,meshInfo); // function from pdmt library

 int ThNn  =  meshInfo[0],                  // # nodes
     ThNni =  meshInfo[1],                  // # inside nodes
     ThNnb =  meshInfo[2],                  // # boundary nodes
     ThNt  =  meshInfo[3],                  // # triangles
     ThNbe =  meshInfo[4];                  // # boundary edges



//-----------------------------------------------------------------------
// create search tables
//-----------------------------------------------------------------------
  int[int] headvb, nextb;                      // search table head and next vertex
  PdmtFillSearchTableEdges(Th,headvb,nextb);   // function from pdmt library

  int[int] headv, next;                        // search table head and next vertex
  PdmtFillSearchTableTriangles(Th,headv,next); // function from pdmt library



//-----------------------------------------------------------------------
// create finite element spaces
//-----------------------------------------------------------------------
  fespace V0h(Th,P0);
  fespace V1h(Th,P1);



//-----------------------------------------------------------------------
// compute nodes/labels for polygons
//-----------------------------------------------------------------------
  V0h   ThTix = x, ThTiy = y;            // nodes at triangle centers
  V1h   ThVix = x, ThViy = y;            // nodes at vertices

  real[int] ThEix(ThNbe), ThEiy(ThNbe);  // nodes at boundary edge centers
  int[int]  ThEiLab(ThNbe);              // labels of edges

  // build barycenter nodes //
  for(int e=0; e<ThNbe;++e){
    ThEix(e) = 0.5*(Th(Th.be(e)[0]).x + Th(Th.be(e)[1]).x); // x coordinate
    ThEiy(e) = 0.5*(Th(Th.be(e)[0]).y + Th(Th.be(e)[1]).y); // y coordinate
    ThEiLab(e) = Th.be(e).label;                            // label on edge
  }

  int[int] PrimalEdgeA(0), PrimalEdgeB(0), PrimalEdgeLab(0);
  int[int,int] TriEdge(ThNt,3);

  for(int t=0; t<ThNt; ++t){
    for(int le=0; le<3; ++le){
      int la = le;
      int lb = (le + 1) % 3;
      int a = Th[t][la];
      int b = Th[t][lb];
      if(a > b){
        int tmp = a;
        a = b;
        b = tmp;
      }

      int foundEdge = -1;
      for(int e=0; e<PrimalEdgeA.n; ++e)
        if(PrimalEdgeA[e] == a && PrimalEdgeB[e] == b)
          foundEdge = e;

      if(foundEdge < 0){
        foundEdge = PrimalEdgeA.n;
        PrimalEdgeA.resize(PrimalEdgeA.n+1);
        PrimalEdgeB.resize(PrimalEdgeB.n+1);
        PrimalEdgeLab.resize(PrimalEdgeLab.n+1);
        PrimalEdgeA[foundEdge] = a;
        PrimalEdgeB[foundEdge] = b;
        PrimalEdgeLab[foundEdge] = 0;
      }

      TriEdge(t,le) = foundEdge;
    }
  }

  for(int be=0; be<ThNbe; ++be){
    int a = Th.be(be)[0];
    int b = Th.be(be)[1];
    if(a > b){
      int tmp = a;
      a = b;
      b = tmp;
    }
    for(int e=0; e<PrimalEdgeA.n; ++e)
      if(PrimalEdgeA[e] == a && PrimalEdgeB[e] == b)
        PrimalEdgeLab[e] = Th.be(be).label;
  }

  real[int] PrimalEdgeX(PrimalEdgeA.n), PrimalEdgeY(PrimalEdgeA.n);
  for(int e=0; e<PrimalEdgeA.n; ++e){
    PrimalEdgeX[e] = 0.5*(Th(PrimalEdgeA[e]).x + Th(PrimalEdgeB[e]).x);
    PrimalEdgeY[e] = 0.5*(Th(PrimalEdgeA[e]).y + Th(PrimalEdgeB[e]).y);
  }



//-----------------------------------------------------------------------
// initialize polyhedral mesh
//-----------------------------------------------------------------------
  real[int,int]  PhV(0,0);
  int [int]      PhELabels;
  int [int][int] PhC;
  int [int][int] PhE;

{
  int PhNn =  ThNt  + ThNnb + ThNbe;
  if(!smoothDual2D)
    PhNn = ThNt + ThNnb + PrimalEdgeA.n;
  int PhNp =  ThNn;
  int PhNe =  ThNbe*2;

  PhV.resize(PhNn,2);
  PhC.resize(PhNp);
  PhE.resize(PhNe);
  PhELabels.resize(PhNp + PhNe);
}



//-----------------------------------------------------------------------
//  fill polygon mesh nodes
//-----------------------------------------------------------------------
{
  int polynodeindex = 0;

  for(int t=0; t<ThNt;++t){
    PhV(polynodeindex,0) = ThTix[][t];
    PhV(polynodeindex,1) = ThTiy[][t];
    polynodeindex++;
  }

  for(int n=0; n<ThNn;++n){
    if(isBorderNode[n]){
      PhV(polynodeindex,0) = ThVix[][n];
      PhV(polynodeindex,1) = ThViy[][n];
      polynodeindex++;
    }
  }

  for(int be=0; be<ThNbe;++be){
    PhV(polynodeindex,0) = ThEix(be);
    PhV(polynodeindex,1) = ThEiy(be);
    polynodeindex++;
  }

  if(!smoothDual2D){
    polynodeindex = ThNt + ThNnb;
    for(int e=0; e<PrimalEdgeA.n; ++e){
      PhV(polynodeindex,0) = PrimalEdgeX[e];
      PhV(polynodeindex,1) = PrimalEdgeY[e];
      polynodeindex++;
    }
  }
}



//-----------------------------------------------------------------------
//  compute polygon mesh cells
//-----------------------------------------------------------------------
// assisting macro
macro vectorPushBack(V, p1, p2, p3)
   V#x.resize(V#x.n+1);
   V#y.resize(V#y.n+1);
   V#Index.resize(V#Index.n+1);

   V#x[V#x.n-1]         = p1;
   V#y[V#y.n-1]         = p2;
   V#Index[V#Index.n-1] = p3;
//

macro vectorPushBackUnique(V, p1, p2, p3)
   int pdmtAlreadyThere = 0;
   for(int pdmtUniqueIt=0; pdmtUniqueIt<V#Index.n; ++pdmtUniqueIt)
     if(V#Index[pdmtUniqueIt] == p3)
       pdmtAlreadyThere = 1;
   if(!pdmtAlreadyThere){
     V#x.resize(V#x.n+1);
     V#y.resize(V#y.n+1);
     V#Index.resize(V#Index.n+1);

     V#x[V#x.n-1]         = p1;
     V#y[V#y.n-1]         = p2;
     V#Index[V#Index.n-1] = p3;
   }
//

// Order every collected dual point around its primal vertex.  Unlike a
// convex hull, this keeps the edge midpoints that lie inside the hull of
// the neighbouring triangle barycentres; those points are required by
// the subdivided dual topology.
macro orderPointsAroundVertex(V, cx, cy)
   for(int pdmtOrderI=0; pdmtOrderI<V#Index.n-1; ++pdmtOrderI){
     int pdmtOrderBest = pdmtOrderI;
     real pdmtOrderAngleBest =
       atan2(V#y[pdmtOrderI]-(cy), V#x[pdmtOrderI]-(cx));
     for(int pdmtOrderJ=pdmtOrderI+1; pdmtOrderJ<V#Index.n; ++pdmtOrderJ){
       real pdmtOrderAngle =
         atan2(V#y[pdmtOrderJ]-(cy), V#x[pdmtOrderJ]-(cx));
       if(pdmtOrderAngle < pdmtOrderAngleBest){
         pdmtOrderBest = pdmtOrderJ;
         pdmtOrderAngleBest = pdmtOrderAngle;
       }
     }
     if(pdmtOrderBest != pdmtOrderI){
       real pdmtOrderTmpX = V#x[pdmtOrderI];
       real pdmtOrderTmpY = V#y[pdmtOrderI];
       int  pdmtOrderTmpI = V#Index[pdmtOrderI];
       V#x[pdmtOrderI] = V#x[pdmtOrderBest];
       V#y[pdmtOrderI] = V#y[pdmtOrderBest];
       V#Index[pdmtOrderI] = V#Index[pdmtOrderBest];
       V#x[pdmtOrderBest] = pdmtOrderTmpX;
       V#y[pdmtOrderBest] = pdmtOrderTmpY;
       V#Index[pdmtOrderBest] = pdmtOrderTmpI;
     }
   }
//

{
  real[int]  Pix(0), Piy(0) ;
  int[int]   PiIndex(0)     ;
  int indexedge = 0         ;
  int indexploy = 0         ;
  int indexnbe  = 0         ;
  V1h PiNe = 0              ;

  for(int v=0; v<ThNn; ++v){

    Pix.resize(0); Piy.resize(0); PiIndex.resize(0);

    if(isBorderNode[v]){

      for(int p=headv[v]; p >=0; p=next[p]){
        int k = p/3;
        vectorPushBack(Pi, ThTix[][k], ThTiy[][k], k );
        PiNe[][v] = PiNe[][v] + 1;
        PhELabels[indexploy] = Th[k].region;

        if(!smoothDual2D){
          for(int le=0; le<3; ++le){
            int ea = Th[k][le];
            int eb = Th[k][(le+1)%3];
            if(ea == v || eb == v){
              int pe = TriEdge(k,le);
              vectorPushBackUnique(Pi, PrimalEdgeX[pe], PrimalEdgeY[pe], int(ThNt + ThNnb + pe));
            }
          }
        }
      }

       //---- original border nodes ----//
       // problematic for convex-hull  //
       //      TO DO TO DO TO DO       //
//      vectorPushBack(Pi, ThVix[][v], ThViy[][v], int(ThNt + indexnbe) );
//      PiNe[][v]      = PiNe[][v] + 1;


      // New procedure for adding the border point //
      int pointBorder =  int(ThNt + indexnbe);
      int[int] posVect(2);
      int[int] edgeLocalLab (2);
      int count=0;

      for(int p=headvb[v]; p >=0; p=nextb[p]){
        int k = p/2;
        int edgeNodeIndex = int(ThNt + ThNnb + k);
        if(!smoothDual2D){
          int ba = Th.be(k)[0];
          int bb = Th.be(k)[1];
          if(ba > bb){
            int tmp = ba;
            ba = bb;
            bb = tmp;
          }
          int primalEdgeIndex = -1;
          for(int pe=0; pe<PrimalEdgeA.n; ++pe)
            if(PrimalEdgeA[pe] == ba && PrimalEdgeB[pe] == bb)
              primalEdgeIndex = pe;
          edgeNodeIndex = int(ThNt + ThNnb + primalEdgeIndex);
        }
        vectorPushBackUnique(Pi, ThEix(k), ThEiy(k), edgeNodeIndex );

        edgeLocalLab[count] = ThEiLab(k);
        posVect[count] = edgeNodeIndex;
        count++;
      }

      if(smoothDual2D)
        pdmtConvexHull(Pix,Piy,PiIndex);
      else
        orderPointsAroundVertex(Pi, ThVix[][v], ThViy[][v]);

      PhC[indexploy].resize(PiIndex.n);

      for(int kk=0; kk < PiIndex.n ; kk++)
        PhC[indexploy][kk] = PiIndex[kk];


     // add the boundary point //
      count   = 0;
      int[int] poskk (2);

      for(int kk=0; kk < PiIndex.n  ; kk++){
        if (PhC[indexploy][kk] == posVect[0] || PhC[indexploy][kk] == posVect[1])
            {
            poskk[count] = kk;count++;
        }
      }

      int pos = poskk[1];
      if(poskk[0] > poskk[1])
        pos = poskk[0];

      // The two boundary midpoints are consecutive in the angular cycle.
      // If they straddle the array boundary, append the primal vertex;
      // otherwise insert it directly between them.
      if(pos - (poskk[0] < poskk[1] ? poskk[0] : poskk[1]) > 1)
        pos = PhC[indexploy].n;

      PhC[indexploy].resize(PhC[indexploy].n+1);

      for (int i = PhC[indexploy].n -1  ; i > pos; i--)
        PhC[indexploy][i] = PhC[indexploy][i - 1];

      PhC[indexploy][pos] = pointBorder;

      PhE[indexedge].resize(2);
      PhE[indexedge][0] = posVect[0];
      PhE[indexedge][1] = pointBorder;
      PhELabels[ThNn + indexedge] = edgeLocalLab[0];
      indexedge++;

      PhE[indexedge].resize(2);
      PhE[indexedge][0] = pointBorder;
      PhE[indexedge][1] = posVect[1];
      PhELabels[ThNn + indexedge] = edgeLocalLab[1];
      indexedge++;

      indexploy++;
      indexnbe++;

    }else{

      for(int p=headv[v]; p>=0; p=next[p]){
        int k = p/3;
        vectorPushBack(Pi, ThTix[][k], ThTiy[][k], k );
        PiNe[][v] = PiNe[][v] + 1;
        PhELabels[indexploy] = Th[k].region;

        if(!smoothDual2D){
          for(int le=0; le<3; ++le){
            int ea = Th[k][le];
            int eb = Th[k][(le+1)%3];
            if(ea == v || eb == v){
              int pe = TriEdge(k,le);
              vectorPushBackUnique(Pi, PrimalEdgeX[pe], PrimalEdgeY[pe], int(ThNt + ThNnb + pe));
            }
          }
        }
      }

      if(smoothDual2D)
        pdmtConvexHull(Pix,Piy,PiIndex);
      else
        orderPointsAroundVertex(Pi, ThVix[][v], ThViy[][v]);

      PhC[indexploy].resize(PiIndex.n);
      for(int kk=0; kk < PiIndex.n ; kk++)
        PhC[indexploy][kk] = PiIndex[kk];

      indexploy++;
    }
  }
}


//-----------------------------------------------------------------------
//  save polygon mesh
//-----------------------------------------------------------------------

/*
// To write a .vtk mesh without edges
  PdmtPolyMeshWrite(  ""+ThName+"_poly_"+mpirank+".vtk",
                      nodes = PhV,
                      cells = PhC
                   );
*/


if (ThNameOut != "PDMT_POLY_MESH_"){

    if (ThNameOut != "PDMT_POLY_MESH_") {
        if (ThNameOut.find(".med") == -1 &&
            ThNameOut.find(".vtu") == -1 &&
            ThNameOut.find(".vtk") == -1 &&
            ThNameOut.find(".typ2") == -1) {

            cout << "\n\n******************* ERROR *************************\n\n"
                 << "  Error in output mesh format\n"
                 << "  PDMT can only output meshes in the following formats:\n\n"
                 << "           .med  - SALOME's mesh format\n"
                 << "           .vtu  - VTK XML format for unstructured grids\n"
                 << "           .vtk  - VTK legacy format for structured and unstructured grids\n"
                 << "           .typ2 - FCVA benchmark mesh format (description needed)\n"
                 << "\n  Please ensure that the output mesh file name has one of the above extensions.\n"
                 << "\n\n******************* ERROR *************************\n\n"
                 << endl;
            exit(1111);
        }
    }

    if(  ThNameOut.find(".med") > -1 || ThNameOut.find(".vtu") > -1 || ThNameOut.find(".vtk") > -1 )
      PdmtPolyMeshWrite(  ThNameOut,
                      nodes = PhV,
                      cells = PhC,
                      edges = PhE,          // this is optional
                      labels = PhELabels    // this is optional
                   );


    if(  ThNameOut.find(".typ2") > -1 )
      PdmtPolyMeshWrite(  ThNameOut,
                      nodes = PhV,
                      cells = PhC
                   );
}else{

// To write a .med mesh with/without edges
//PdmtPolyMeshWrite(  ""+ThName+"_poly_"+mpirank+".med",
/*
  PdmtPolyMeshWrite(  ""+ThName+"_poly.med",
                      nodes = PhV,
                      cells = PhC,
                      edges = PhE,          // this is optional
                      labels = PhELabels    // this is optional
                   );


//PdmtPolyMeshWrite(  ""+ThName+"_poly_mpirank_"+mpirank+".vtk",
  PdmtPolyMeshWrite(  ""+ThName+"_poly.vtk",
                      nodes = PhV,
                      cells = PhC,
                      edges = PhE,          // this is optional
                      labels = PhELabels    // this is optional
                   );
*/
  PdmtPolyMeshWrite(  ""+ThName+"_poly.vtu",
                      nodes = PhV,
                      cells = PhC,
                      edges = PhE,          // this is optional
                      labels = PhELabels    // this is optional
                   );
/*
  PdmtPolyMeshWrite(  ""+ThName+"_poly.typ2",
                      nodes = PhV,
                      cells = PhC
                 );
*/
}
  return 0;
}

string dimension = getARGV("--dimension", "2");

if (dimension == "2")
  run2D();
if (dimension == "3")
  run3D();
if (dimension == "3S" || dimension == "3s")
  run3S();
if (dimension != "2" && dimension != "3" && dimension != "3S" && dimension != "3s") {
  cout << "PDMT --dimension must be 2, 3, or 3S" << endl;
  exit(1111);
}
