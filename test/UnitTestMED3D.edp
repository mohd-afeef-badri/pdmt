load "./../src/pdmt"
load "./../ext/medio-1.1/src/medio"
load "gmsh"

// Exercise tetrahedral MED input and native polyhedral MED output.
mesh3 TetInput = readmesh3("single_tetra.mesh3d");
savemedmesh(TetInput, "single_tetra_input.med");
mesh3 Tet = PdmtLoadMedMesh3("single_tetra_input.med",
                             meshname="TetrahedralMesh");
if (Tet.nv != 4 || Tet.nt != 1 || Tet.nbe != 4) exit(401);

real[int,int] volumeNodes(0,0);
int[int][int] volumeFaces, volumeCells;
int[int] volumeLabels, volumeFaceLabels;
int volumeCount = PdmtBuildDual3D(Tet,
    nodes=volumeNodes, faces=volumeFaces, cells=volumeCells,
    labels=volumeLabels, faceLabels=volumeFaceLabels);
if (volumeCount != 4) exit(402);
PdmtPolyMeshWrite("single_tetra_poly.med",
    nodes=volumeNodes, faces=volumeFaces, cells=volumeCells,
    labels=volumeLabels, faceLabels=volumeFaceLabels);

// Exercise triangular-surface MED input and polygonal-surface MED output.
meshS SurfaceInput = gmshloadS("closed_surface.msh3d");
savemedmesh(SurfaceInput, "closed_surface_input.med");
meshS Surface = PdmtLoadMedMeshS("closed_surface_input.med",
                                 meshname="TriangularMesh");
if (Surface.nv != 4 || Surface.nt != 4) exit(403);

real[int,int] surfaceNodes(0,0);
int[int][int] surfaceCells;
int[int] surfaceLabels;
int surfaceCount = PdmtBuildDual3S(Surface,
    nodes=surfaceNodes, cells=surfaceCells, labels=surfaceLabels,
    featureAngle=180.0, mode="smooth_dual");
if (surfaceCount != 4) exit(404);
PdmtPolyMeshWrite("closed_surface_poly.med",
    nodes=surfaceNodes, cells=surfaceCells, labels=surfaceLabels);

// ALL selects every group on the MED edge level. Compare against the same
// smooth dual without conservation to ensure group "bla" changes connectivity.
string groupedVolumeFile = "./../msh/cylinder_edge.med";
mesh3 GroupedVolume = PdmtLoadMedMesh3(
    groupedVolumeFile, meshname="cylinder_edge");
real[int,int] groupedSmoothNodes(0,0), groupedAllNodes(0,0);
int[int][int] groupedSmoothFaces, groupedSmoothCells;
int[int][int] groupedAllFaces, groupedAllCells;
int[int] groupedSmoothLabels, groupedSmoothFaceLabels;
int[int] groupedAllLabels, groupedAllFaceLabels;

int groupedSmoothCount = PdmtBuildDual3D(GroupedVolume,
    nodes=groupedSmoothNodes, faces=groupedSmoothFaces,
    cells=groupedSmoothCells, labels=groupedSmoothLabels,
    faceLabels=groupedSmoothFaceLabels, featureAngle=180.0,
    mode="smooth_dual");
int groupedAllCount = PdmtBuildDual3D(GroupedVolume,
    nodes=groupedAllNodes, faces=groupedAllFaces, cells=groupedAllCells,
    labels=groupedAllLabels, faceLabels=groupedAllFaceLabels,
    featureAngle=180.0, meshFile=groupedVolumeFile,
    medMeshName="cylinder_edge", conserveEdge="ALL",
    mode="smooth_dual");
if (groupedSmoothCount != GroupedVolume.nv ||
    groupedAllCount != GroupedVolume.nv) exit(405);
if (groupedAllNodes.n <= groupedSmoothNodes.n ||
    groupedAllFaces.n <= groupedSmoothFaces.n) exit(406);

string groupedSurfaceFile = "./../msh/cylinder_surface_edge.med";
meshS GroupedSurface = PdmtLoadMedMeshS(
    groupedSurfaceFile, meshname="cylinder_surface_edge");
real[int,int] surfaceSmoothNodes(0,0), surfaceAllNodes(0,0);
int[int][int] surfaceSmoothCells, surfaceAllCells;
int[int] surfaceSmoothGroupLabels, surfaceAllGroupLabels;

int surfaceSmoothCount = PdmtBuildDual3S(GroupedSurface,
    nodes=surfaceSmoothNodes, cells=surfaceSmoothCells,
    labels=surfaceSmoothGroupLabels, featureAngle=180.0,
    mode="smooth_dual");
int surfaceAllCount = PdmtBuildDual3S(GroupedSurface,
    nodes=surfaceAllNodes, cells=surfaceAllCells,
    labels=surfaceAllGroupLabels, featureAngle=180.0,
    meshFile=groupedSurfaceFile, medMeshName="cylinder_surface_edge",
    conserveEdge="ALL", mode="smooth_dual");
if (surfaceSmoothCount <= 0 || surfaceAllCount <= surfaceSmoothCount) exit(407);
if (surfaceAllNodes.n <= surfaceSmoothNodes.n ||
    surfaceAllCells.n <= surfaceSmoothCells.n) exit(408);

cout << "PDMT 3D/3S MED I/O unit test passed" << endl;
